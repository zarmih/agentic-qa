# Required for `agentic-qa plan`.
AGENTIC_QA_LLM_BASE_URL=
AGENTIC_QA_LLM_MODEL=

# Optional: leave empty for a local endpoint that explicitly requires no authentication.
AGENTIC_QA_LLM_API_KEY=
AGENTIC_QA_LLM_TIMEOUT_MS=30000

# Optional bounded Stage 5 execution settings. `run` does not use the LLM values above.
AGENTIC_QA_MAX_EXECUTION_SCENARIOS=20
AGENTIC_QA_MAX_STEPS_PER_SCENARIO=10
AGENTIC_QA_EXECUTION_TIMEOUT_MS=300000
AGENTIC_QA_STEP_TIMEOUT_MS=5000

# Optional bounded Stage 6 verification settings. `verify` remains LLM-free.
AGENTIC_QA_VERIFY_ATTEMPTS=3
AGENTIC_QA_MAX_VERIFY_FINDINGS=10
AGENTIC_QA_VERIFY_TIMEOUT_MS=900000

# Optional bounded Stage 7 generation settings. `generate` launches no browser or LLM.
AGENTIC_QA_MAX_GENERATED_TESTS=20
AGENTIC_QA_MAX_GENERATED_STEPS_PER_TEST=12
AGENTIC_QA_MAX_GENERATED_ASSERTIONS_PER_TEST=5
